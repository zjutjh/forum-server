<!-- 用户模块：org.jh/forum-user/pom.xml -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承父 POM -->
    <parent>
        <groupId>org.jh</groupId>
        <artifactId>forum</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath> <!-- 显式指定父 POM 路径 [[2]] -->
    </parent>

    <!-- 模块基本信息 -->
    <artifactId>forum-user</artifactId>
    <name>精弘论坛-用户模块</name>
    <description>用户信息管理模块，包含个人信息展示、编辑资料等功能 [[4.2.2]]</description>

    <!-- 依赖项 -->
    <dependencies>
        <!-- Spring Boot 核心依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- 数据库驱动 -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 公共模块依赖 -->
        <dependency>
            <groupId>org.jh</groupId>
            <artifactId>forum-common</artifactId> <!-- 公共工具类 [[3]] -->
        </dependency>
        <dependency>
            <groupId>org.jh</groupId>
            <artifactId>forum-api</artifactId> <!-- API 接口定义 [[3]] -->
        </dependency>

        <!-- Dubbo 服务治理 -->
        <dependency>
            <groupId>org.apache.dubbo</groupId>
            <artifactId>dubbo</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.csp</groupId>
            <artifactId>sentinel-transport-simple-http</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.csp</groupId>
            <artifactId>sentinel-apache-dubbo3-adapter</artifactId>
        </dependency>

        <!-- 测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- 构建配置 -->
    <build>
        <plugins>
            <!-- Spring Boot 打包插件 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>org.jh.forum.user.UserApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>